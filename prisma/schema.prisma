datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model DesignerProfile {
  id              String   @id @default(uuid())
  designerAddress String   @unique
  brandName       String
  specialty       String
  tier            String   @default("Emerging")
  reputationScore Int      @default(50)
  registeredAt    DateTime @default(now())
  updatedAt       DateTime @updatedAt
  passports       ProductPassport[]
}

model ProductPassport {
  id            String   @id @default(uuid())
  productId     String   @unique
  designerId    String
  designer      DesignerProfile @relation(fields: [designerId], references: [designerAddress])
  materialsHash String
  batchSize     Int
  status        String   @default("Authentic")
  mintedAt      DateTime @default(now())
}

model EscrowAgreement {
  id            Int      @id
  buyerAddress  String
  sellerAddress String
  amountStroops String
  currentStage  Int      @default(1)
  isDisputed    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FinancingCampaign {
  id             Int      @id
  designerAddress String
  targetStroops  String
  raisedStroops  String   @default("0")
  yieldBps       Int
  durationDays   Int
  status         String   @default("Active")
  createdAt      DateTime @default(now())
}
